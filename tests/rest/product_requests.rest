@baseUrl = http://127.0.0.1:5000

### Login de administrador
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "drt": "900000000",
  "senha_digitada": "Admteste123"
}

### Captura automática do token
@token = {{login.response.body.token}}

### Cadastrar produto de teste (esperado: 201; se já existir, 409)
POST {{baseUrl}}/cadastrar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "nome_produto": "Sabao em po teste",
  "valor_prod": 29.90,
  "setor_id": 5
}

### Cadastrar produto sem campo obrigatório (esperado: 400)
POST {{baseUrl}}/cadastrar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987728"
}

### Buscar produto existente (esperado: 200; exige produto previamente cadastrado)
POST {{baseUrl}}/consultar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727"
}

### Buscar produto inexistente (esperado: 404)
POST {{baseUrl}}/consultar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "0000000000000"
}

### Consultar estoque (esperado: 200)
GET {{baseUrl}}/estoque
Authorization: Bearer {{token}}

### Ajustar quantidade (esperado: 200; motivo 2 = Compra de produto)
POST {{baseUrl}}/EditarQuantidade
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "quantidade": 60,
  "motivo": 2
}

### Quantidade negativa (esperado: 422)
POST {{baseUrl}}/EditarQuantidade
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "quantidade": -1,
  "motivo": 2
}

### Alterar valor (esperado: 200)
POST {{baseUrl}}/EditarValor
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_valor": 30.00
}

### Valor inválido (esperado: 422)
POST {{baseUrl}}/EditarValor
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_valor": -1
}

### Valor zero (esperado: 200)
POST {{baseUrl}}/EditarValor
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_valor": 0
}

### Restaurar o valor do produto (esperado: 200)
POST {{baseUrl}}/EditarValor
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_valor": 30.00
}

### Alterar setor (esperado: 200)
POST {{baseUrl}}/ajuste_setor_produto
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_setor": 2
}

### Setor inexistente (esperado: 404)
POST {{baseUrl}}/ajuste_setor_produto
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_setor": 999
}

### Setor zero inválido (esperado: 422)
POST {{baseUrl}}/ajuste_setor_produto
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "novo_setor": 0
}

### Motivo inexistente no ajuste (esperado: 404; estoque não deve ser alterado)
POST {{baseUrl}}/EditarQuantidade
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "quantidade": 61,
  "motivo": 999
}

### Consultar movimentações (esperado: 200)
GET {{baseUrl}}/movimentacoes
Authorization: Bearer {{token}}

### Excluir produto inexistente (esperado: 404)
PUT {{baseUrl}}/ExcluirProduto
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo_barras": "0000000000000",
  "motivo": 9
}



### Marcar produto de teste como excluído (esperado: 200; execute por último)
PUT {{baseUrl}}/ExcluirProduto
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "motivo": 9
}

### Produto excluído não aparece na consulta (esperado: 404)
POST {{baseUrl}}/consultar
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727"
}

### Produto excluído não pode ter o estoque ajustado (esperado: 404)
POST {{baseUrl}}/EditarQuantidade
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "codigo_barras": "7890000987727",
  "quantidade": 10,
  "motivo": 2
}
